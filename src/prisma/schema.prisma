// Prisma schema for the "centrix" Steam manifest game catalog & rental API.
// Prisma 7 — uses the new `prisma-client` generator (TypeScript output).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Application roles for authentication and authorization.
enum Role {
  ADMIN
  CUSTOMER
  STREAMER
}

/// Supported pricing currencies.
enum Currency {
  VND
  USD
  CNY
}

/// Status of user game rental subscriptions.
enum RentalStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  REVOKED
}

/// Payment transaction status.
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

/// A single game imported from SteamDB or managed in catalog.
model Product {
  id          String    @id @default(uuid())
  appId       Int       @unique // Steam AppID
  name        String
  description String?
  imageUrl    String?
  releaseDate DateTime?
  developer   String?
  publisher   String?

  genres     String[] @default([])
  categories String[] @default([])
  tags       String[] @default([])
  platforms  String[] @default([])

  disabled  Boolean   @default(false) // display toggle (true == hidden/disabled in app)
  invisible Boolean   @default(false) // soft-deleted
  scrapedAt DateTime?
  sourceUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-currency prices (one row per currency).
  prices ProductPrice[]

  // Downloadable content belonging to this game.
  dlcs DLC[]

  // Steam manifest and Lua script files linked by appId.
  manifests ManifestFile[]

  // Users who explicitly own this game (many-to-many direct relation).
  owners User[] @relation("UserProducts")

  // Rented game records for customers/streamers.
  userGames UserGame[]

  // Linked categories/platforms (EA, Ubisoft, Denuvo, Rockstar, etc.).
  productCategories ProductCategory[]

  @@index([disabled])
  @@index([invisible])
  @@map("products")
}

/// Per-currency price for a product.
model ProductPrice {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  currency  Currency
  amount    Decimal  @default(0) @db.Decimal(18, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, currency])
  @@index([productId])
  @@map("product_prices")
}

/// Downloadable content for a game.
model DLC {
  id        String   @id @default(uuid())
  appId     Int      @unique // Steam AppID of the DLC
  name      String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("dlcs")
}

/// Steam manifest and Lua script files linked by AppID.
model ManifestFile {
  id           String   @id @default(uuid())
  appId        Int
  product      Product  @relation(fields: [appId], references: [appId], onDelete: Cascade)
  manifestData Bytes? // Encrypted/binary payload or manifest JSON
  luaScript    String?  @db.Text // Lua script content for Steam unlocker
  isEnabled    Boolean  @default(true) // soft delete flag (true == enabled, false == deleted/disabled)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userGames UserGame[]

  @@index([appId])
  @@index([isEnabled])
  @@map("manifest_files")
}

/// Game categories/protection platforms (e.g. EA, Ubisoft, Denuvo, Rockstar).
model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productCategories ProductCategory[]

  @@map("categories")
}

/// Many-to-many join model connecting Product (by AppID) to Category with a download link (dataUrl).
model ProductCategory {
  id         String   @id @default(uuid())
  appId      Int
  product    Product  @relation(fields: [appId], references: [appId], onDelete: Cascade)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  dataUrl    String?  @db.Text // Download link for luascript / category payload
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([appId, categoryId])
  @@index([appId])
  @@index([categoryId])
  @@map("product_categories")
}

/// Customer, Streamer, or Admin account.
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role             Role      @default(CUSTOMER)
  isBlock          Boolean   @default(false) // Admin restriction flag upon violation
  isVerified       Boolean   @default(false) // Email verification status
  verificationCode String?   // 6-digit verification code
  codeExpiresAt    DateTime? // Expiration timestamp (10 minutes after dispatch)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Direct product purchases
  products Product[] @relation("UserProducts")

  // Issued authentication & refresh tokens
  tokens Token[]

  // Login event audit log for weekly IP rate limiting
  loginLogs LoginLog[]

  // Rented games subtable
  userGames UserGame[]

  // Payment transactions ledger
  bills Bill[]

  @@index([isVerified, codeExpiresAt])
  @@map("users")
}

/// Authentication sessions storing JWT access token ID and refresh tokens.
model Token {
  id           String   @id @default(uuid())
  token        String   @unique
  refreshToken String   @unique
  expiredAt    DateTime
  ipAddress    String?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("tokens")
}

/// Log of user login events to enforce 3 logins per week limit per IP + User combination.
model LoginLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  ipAddress String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email, ipAddress, createdAt])
  @@map("login_logs")
}

/// User's rented games subtable.
model UserGame {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  manifestId     String?
  manifest       ManifestFile? @relation(fields: [manifestId], references: [id], onDelete: SetNull)
  rentedAt       DateTime      @default(now())
  expiresAt      DateTime
  status         RentalStatus  @default(ACTIVE)
  rentalPrice    Decimal       @default(0) @db.Decimal(18, 4)
  rentalCurrency Currency      @default(VND)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([productId])
  @@map("user_games")
}

/// Payment and billing history for author / admin accounting.
model Bill {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Decimal       @default(0) @db.Decimal(18, 4)
  currency       Currency      @default(VND)
  paymentMethod  String        @default("SYSTEM")
  transactionRef String?       @unique
  status         PaymentStatus @default(COMPLETED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@map("bills")
}

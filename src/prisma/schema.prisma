// Prisma schema for the "centrix" Steam manifest game catalog & rental API.
// Prisma 7 — uses the new `prisma-client` generator (TypeScript output).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Application roles for authentication and authorization.
enum Role {
  ADMIN
  CUSTOMER
  STREAMER
  MOD
}

/// Supported pricing currencies.
enum Currency {
  VND
  USD
  CNY
}

/// Payment transaction status.
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

/// A single game imported from SteamDB or managed in catalog.
model Product {
  id          String    @id @default(uuid())
  appId       Int       @unique // Steam AppID
  name        String
  description String?
  imageUrl    String?
  releaseDate DateTime?
  developer   String?
  publisher   String?

  platforms String[] @default([])

  disabled Boolean @default(false) // display toggle (true == hidden/disabled in app)
  isDelete Boolean @default(false) // soft-deleted
  isDenuvo Boolean @default(false) // Denuvo DRM protection flag

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-currency prices (one row per currency).
  prices ProductPrice[]

  // Downloadable content belonging to this game.
  dlcs DLC[]

  // Steam manifest files linked by appId.
  manifests ManifestFile[]

  // Users who explicitly own this game (many-to-many direct relation).
  owners User[] @relation("UserProducts")

  // Linked game categories (many-to-many via Category model).
  categories Category[]

  // Protection platform / launcher integration type (1:N relation to Type model).
  typeId Int?
  type   Type? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  @@index([typeId])
  @@index([disabled])
  @@index([isDelete])
  @@index([isDenuvo])
  @@map("products")
}

/// Per-currency price for a product.
model ProductPrice {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  currency  Currency
  amount    Decimal  @default(0) @db.Decimal(18, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, currency])
  @@index([productId])
  @@map("product_prices")
}

/// Downloadable content for a game.
model DLC {
  id        String   @id @default(uuid())
  appId     Int      @unique // Steam AppID of the DLC
  name      String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("dlcs")
}

/// Steam manifest download URLs linked by AppID.
model ManifestFile {
  id          String   @id @default(uuid())
  appId       Int      @unique
  product     Product  @relation(fields: [appId], references: [appId], onDelete: Cascade)
  manifestUrl String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("manifest_files")
}

/// Product categories (combined genres and categories per product).
model Category {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, name])
  @@index([productId])
  @@index([name])
  @@map("categories")
}

/// Protection platforms and launcher integration types (e.g. EA, Ubisoft, Denuvo, Rockstar).
model Type {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())

  products     Product[]
  thirdParties ThirdParty[]

  @@map("types")
}

/// Third-party files linked to a protection/launcher Type (1:N relation).
model ThirdParty {
  id        String   @id @default(uuid())
  typeId    Int
  type      Type     @relation(fields: [typeId], references: [id], onDelete: Cascade)
  fileUrl   String   @db.Text
  createdAt DateTime @default(now())

  @@index([typeId])
  @@map("third_party")
}

/// Customer, Streamer, or Admin account.
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role             Role      @default(CUSTOMER)
  isBlock          Boolean   @default(false) // Admin restriction flag upon violation
  isVerified       Boolean   @default(false) // Email verification status
  verificationCode String?   // 6-digit verification code
  codeExpiresAt    DateTime? // Expiration timestamp (10 minutes after dispatch)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Direct product purchases
  products Product[] @relation("UserProducts")

  // Issued authentication & refresh tokens
  tokens Token[]

  // Login event audit log for weekly IP rate limiting
  loginLogs LoginLog[]

  // Payment transactions ledger
  bills Bill[]

  // Customer orders
  orders Order[]

  @@index([isVerified, codeExpiresAt])
  @@map("users")
}

/// Authentication sessions storing JWT access token ID and refresh tokens.
model Token {
  id           String   @id @default(uuid())
  token        String   @unique
  refreshToken String   @unique
  expiredAt    DateTime
  ipAddress    String?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("tokens")
}

/// Log of user login events to enforce 3 logins per week limit per IP + User combination.
model LoginLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  ipAddress String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email, ipAddress, createdAt])
  @@map("login_logs")
}

/// Payment and billing history for author / admin accounting.
model Bill {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Decimal       @default(0) @db.Decimal(18, 4)
  currency       Currency      @default(VND)
  paymentMethod  String        @default("SYSTEM")
  transactionRef String?       @unique
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order?

  @@index([userId])
  @@map("bills")
}

/// Customer orders for SePay payment processing.
model Order {
  id        String        @id @default(uuid())
  orderCode String        @unique
  amount    Decimal       @db.Decimal(18, 4)
  status    PaymentStatus @default(PENDING)
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  billId    String?       @unique
  bill      Bill?         @relation(fields: [billId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([orderCode])
  @@index([userId])
  @@map("orders")
}

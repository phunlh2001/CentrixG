# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/centrix?schema=public"

# Application
PORT=3000

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Resend Mail Provider
RESEND_API_KEY="re_something"
RESEND_FROM_EMAIL="Centrix Gaming <onboarding@resend.dev>"

# Supabase Storage Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SECRET_KEY="your-secret-key"
SUPABASE_MANIFEST_BUCKET="manifests"

# SePay Configuration
SEPAY_API_KEY=""
SEPAY_WEBHOOK_SECRET=""
SEPAY_ACCOUNT_NUMBER=""
SEPAY_ACCOUNT_NAME=""
SEPAY_BANK_NAME=""
